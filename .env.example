# Internal M2M API Credentials & Settings
# Use http://api-internal.iotcloud_healthcheck:8001 when accessing via WireGuard VPN
# Use http://localhost:8001 when running locally on the backend host
INTERNAL_API_URL=http://api-internal.iotcloud_healthcheck:8001
M2M_TOKEN=your_m2m_token_here
THERMOSTAT_SENSOR_ID=demo_thermostat
AUTH0_DOMAIN=https://iotauth.eu.auth0.com

# Target Location & Device (Demo Virtual Suite)
IOTCLOUD_LOCATION_ID=5d0000000000000000000001
IOTCLOUD_DEVICE_ID=demo_virtual_hub_01
SWITCH_SENSOR_ID=demo_switch

# Telegram Notifications
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Service Settings (optional defaults)
# CHECK_INTERVAL_SECONDS=300
# LOG_PATH=logs/healthCheck.log
# LOG_LEVEL=INFO


